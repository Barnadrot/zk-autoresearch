# Target repos ��� clone separately per setup scripts
/Plonky3/
/plonky3/
/leanMultisig/
/jolt/
/sp1/

# Standalone crates (separate git repos)
/zk-alloc/
/plonky3-bench/

# Methodology / spec docs (private)
/ar-methodology/

# Brain operational tree — entire folder is private (session UUIDs, RC URLs,
# executor SSH targets, persona layout, ad-hoc analyses — all attack surface
# if Claude Code is ever exploited for prompt injection). Public template
# scaffolding lives at brain_example/.
/brain/

# Reference allocator repos (cloned for study)
/glibc-malloc/
/mimalloc/
/snmalloc/

# Python
.venv/
__pycache__/
*.pyc

# Runtime files
experiments.jsonl
run_provenance.json
*.bak.jsonl
bench_debug.txt
STOP

# Legacy agent context files
changelog.md
changelog_target.md
improvement_ideas.md
agent_context.md
tests_guidance.md

# Internal analysis — experiment_logs/**/report/ stays private even though
# the rest of experiment_logs/ is public scientific record. brain/report/
# is covered above by /brain/.
experiment_logs/**/report/

# Coordinator working directory — long-lived Sonnet session, has its own UUID
# and pulls in any state files coordinator writes.
coordinator/

# Workspace-level Claude Code config — persona files reference live infra
# layout and would aid an attacker in mapping the system.
.claude/

# Synthetic test artifacts (kept locally for the audit but not for shipping)
experiment_logs/test/

# Build artifacts
harness/*/bench/target/
harness/*/correctness/target/

# Profiling data (large, ephemeral)
harness/leanmultisig/bench/perf*.data*
harness/leanmultisig/bench/heaptrack.*
harness/leanmultisig/bench/dhat.*
