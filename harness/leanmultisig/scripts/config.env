# leanMultisig autoresearch — gate configuration
#
# Source this file from eval_*.sh scripts or set these vars in the loop
# orchestrator's environment. All values are leanMultisig-specific; tune
# only with experimental evidence.

# --- Wall-clock paired gate (eval_paired.sh) ------------------------
# Uses prove_loop (fat LTO, zk-alloc, 1550 sigs, log_inv_rate=1).
# Keep threshold: Δ% must be <= -KEEP_THRESHOLD_PCT AND p < 0.01.
# 1.0% is ~2σ against idle noise (0.51%). Conservative but resolvable.
KEEP_THRESHOLD_PCT=1.0

# Proofs per prove_loop run. Proof 0 = cold warmup, 1+ = warm steady-state.
N_PROOFS=5

# --- Environment pre-flight (env_preflight.sh) ----------------------
# 1-min load average must be < this threshold for the gate to run.
# 1.0 = generous (some background fine); 0.5 = strict (only experiment running).
ENV_PREFLIGHT_LOAD_THRESHOLD=1.0

# --- Keep auto-chain (eval_paired.sh) -------------------------------
# When a fast-tier keep lands, automatically:
#  1. AUTO_CUMULATIVE_ON_KEEP=1 → eval_cumulative.sh anchors HEAD vs origin/main.
#  2. AUTO_SHIP_GATE_ON_KEEP=1  → eval_ship_gate.sh confirms via Criterion.
# Set to 0 to disable individual stages (e.g., AUTO_SHIP_GATE_ON_KEEP=0 for
# fast iteration where Criterion confirmation isn't needed per iter).
AUTO_CUMULATIVE_ON_KEEP=1
AUTO_SHIP_GATE_ON_KEEP=1

# --- Ship gate Criterion timing (eval_ship_gate.sh) -----------------
# Measurement time per side (baseline-save and candidate-compare).
# 60s = strong signal, ~3min total. 30s = ~1.5min total, looser CIs.
SHIP_GATE_MEASURE_SECS=60
SHIP_GATE_SAMPLE_SIZE=10

# Criterion noise_threshold is set in benches/xmss_leaf.rs at 0.7%
# (criterion_group config). Genuine sub-fast-tier-gate wins (e.g. 0.7-1.0%
# real improvements that Criterion's bootstrap CI confidently places below
# -0.7%) classify as "improved" rather than "within noise threshold".
# Re-tune if hardware idle σ shifts materially (currently ~0.51% on Hetzner).

# --- Revert-A/B (eval_revert_ab.sh) ---------------------------------
# Revert must reproduce at least this fraction of the claimed improvement
# (positive delta when the keep is reverted on top of HEAD).
MIN_REPRODUCE_FRACTION=0.5

# --- Hibernated thresholds (eval_iai.sh, see _legacy/) --------------
# IAI_MIN_DROP_PCT, IAI_MAX_REGR_PCT removed here. If reactivating iai for a
# sumcheck-shape experiment, re-add them per _legacy/README.md.
