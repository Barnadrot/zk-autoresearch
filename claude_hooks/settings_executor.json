{
  "_comment": "Executor hook config. Copy to ~/zk-autoresearch/.claude/settings.json on executor machines.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "bash ~/zk-autoresearch/claude_hooks/phase_gate.sh"}]
      },
      {
        "matcher": "Write",
        "hooks": [{"type": "command", "command": "bash ~/zk-autoresearch/claude_hooks/phase_gate.sh"}]
      },
      {
        "matcher": "Edit",
        "hooks": [{"type": "command", "command": "bash ~/zk-autoresearch/claude_hooks/phase_gate.sh"}]
      },
      {
        "matcher": "Read",
        "hooks": [{"type": "command", "command": "bash ~/zk-autoresearch/claude_hooks/phase_gate.sh"}]
      },
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "bash ~/zk-autoresearch/claude_hooks/review_gate.sh"}]
      },
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "bash ~/zk-autoresearch/claude_hooks/research_goal.sh"}]
      },
      {
        "matcher": "ScheduleWakeup",
        "hooks": [{"type": "command", "command": "bash ~/zk-autoresearch/claude_hooks/research_goal.sh"}]
      }
    ]
  }
}
